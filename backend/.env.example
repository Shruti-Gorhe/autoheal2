APP_ENV=local

# LLM: local Llama 3.2 through Ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

# GitHub integration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# Optional isolated validation workspace
ISOLATED_REPO_PATH=
ISOLATED_TEST_COMMAND=python -m pytest -q

# Phoenix observability
# Local Phoenix is the default and requires no API key.
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=autoheal-cicd
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=
OTEL_SERVICE_NAME=autoheal-cicd
OTEL_SERVICE_VERSION=1.0.0
OTEL_CONSOLE_EXPORTER=true

# Local RAG
RAG_KNOWLEDGE_DIR=../knowledge_base
RAG_TOP_K=4
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_USE_SEMANTIC=true
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

ADK_ENABLED=true
